<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ reads this instead of android:allowBackup for the two transfer
    paths it added. Both are refused for the same reason the legacy flag is:
    ZoneCraft's database holds the user's whole map, the OpenStreetMap outbox
    and a tile cache that implies where they have been, and PRIVACY.md promises
    that stays on the device.

    Export in the app is the supported way to move a map to another phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
