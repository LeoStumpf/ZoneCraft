<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Map tiles + Overpass overlays. Declared here (not only in the debug
         overlay) so the release build can reach the network. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Foreground-only location, requested at runtime when the user taps
         "Locate me" or starts recording a track (never at launch).
         No ACCESS_BACKGROUND_LOCATION and no foreground service: recording
         runs only while the app is open, which is what PRIVACY.md promises. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="ZoneCraft"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Shared positions: zonecraft://p?lat=..&lng=..&n=..
                 A custom scheme, not an https App Link: verifying one needs a
                 domain serving .well-known/assetlinks.json, and there is none.
                 The cost is that WhatsApp will not make it tappable, which is
                 why the shared message also carries the plain coordinates and
                 why Settings has a "Paste coordinates" box that parses them.
                 Adding https later is this block plus a hosted file — no code
                 change. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="zonecraft"/>
            </intent-filter>
            <!-- Opening a place from somewhere else: the standard geo: intent
                 every map-aware app emits, and an ordinary openstreetmap.org
                 link. This is what puts ZoneCraft in the chooser next to Maps
                 and the ride apps when a coordinate or an OSM URL is tapped.

                 SEPARATE <intent-filter> elements, and separate from the
                 zonecraft:// one above, on purpose: <data> cross-products
                 WITHIN a filter, so folding these in would turn that
                 scheme-only match into a scheme x host product and silently
                 kill shared positions — on a device, with no error.
                 test/android_manifest_test.dart guards exactly that.

                 No Kotlin change is needed: MainActivity.incomingUri() only
                 claims content:/file: uris, so a geo:/https VIEW intent falls
                 through to app_links, the same route zonecraft:// takes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="geo"/>
            </intent-filter>
            <!-- Not an App Link (no android:autoVerify): verifying one needs a
                 domain we control serving .well-known/assetlinks.json, and
                 openstreetmap.org is not ours. Unverified means Android offers
                 a chooser rather than opening ZoneCraft straight away, which is
                 the right behaviour for someone else's site anyway. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:scheme="http"/>
                <data android:host="www.openstreetmap.org"/>
                <data android:host="openstreetmap.org"/>
                <data android:host="osm.org"/>
            </intent-filter>
            <!-- Receiving a geometry file: another app's share sheet (SEND) or
                 a tap in a file manager (VIEW). Both land in importBytesFlow
                 via the com.leostumpf.zonecraft/files channel.

                 ACTION_SEND resolves on MIME TYPE ALONE — the uri in
                 EXTRA_STREAM is invisible to the matcher, so no extension and
                 no pathPattern can help here. application/octet-stream is in
                 the list for the same reason it is in `_importGroup` (see
                 ui/import_actions.dart): Android's extension→MIME map has no
                 entry for .geojson, so our OWN exports are shared as
                 octet-stream, and a share target that cannot receive the file
                 the app just wrote is not a share target. The cost is showing
                 up in the chooser when an unknown *binary* is shared.

                 text/plain and */* are deliberately absent: text/plain is the
                 ubiquitous "share this text" intent every browser and
                 messenger fires, and */* is every photo and video on the
                 phone. A file that isn't geometry is rejected with a message
                 either way.

                 These are separate <intent-filter> elements from the
                 zonecraft:// one above on purpose: <data> cross-products only
                 within its own filter, so adding a mimeType there would turn
                 that scheme-only match into a scheme×mime product and
                 silently kill shared positions. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/geo+json"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/>
                <data android:mimeType="application/vnd.google-earth.kmz"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- Tapping the file itself ("Open with"). No BROWSABLE: a web
                 page has no business launching an import, and Chrome's "open
                 downloaded file" uses DEFAULT with a content: uri anyway. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/geo+json"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/>
                <data android:mimeType="application/vnd.google-earth.kmz"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- So the About screen's links can be opened. Since API 30 a package
             is invisible unless it is queried for, and url_launcher's
             canLaunchUrl returns false for every browser without this. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
